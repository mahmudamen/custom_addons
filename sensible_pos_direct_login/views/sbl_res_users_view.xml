<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sbl_view_users_form_inherit" model="ir.ui.view">
        <field name="name">sbl.res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="preferences" position="after">
                <group string="Point of Sale" name="sbl_pos" invisible="share">
                    <field name="sbl_allow_direct_login" widget="boolean_toggle"/>
                    <field name="sbl_pos_config_id" domain="[('company_id', '=', company_id)]" 
                        invisible="not sbl_allow_direct_login"
                        required="sbl_allow_direct_login"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
