<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_assigned_department_user" model="res.groups">
        <field name="name">User: Assigned department Only</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">The user will have access to his assigned department.</field>
    </record>


    <data noupdate="1">

        <record id="hr_employee_assigned_users" model="ir.rule">
            <field name="name">hr.employee</field>
            <field ref="hr.model_hr_employee" name="model_id"/>
            <field name="domain_force">
                [('department_id.assigned_user_ids','in',user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_assigned_department_user'))]"/>
        </record>
    </data>

</odoo>
