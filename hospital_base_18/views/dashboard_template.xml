<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="hospital_dashboard">
        <t t-call="web.layout">
            <div class="dashboard-container">
                <div class="filters">
                    <select id="dateFilter">
                        <option value="today">Today</option>
                        <option value="current_week">Current Week</option>
                        <option value="last_week">Last Week</option>
                        <option value="current_month">Current Month</option>
                        <option value="last_month">Last Month</option>
                    </select>
                </div>

                <div class="kpi-container">
                    <div class="kpi-card" id="patients-kpi">
                        <h3>Patients</h3>
                        <div class="value">0</div>
                    </div>
                    <div class="kpi-card" id="rooms-kpi">
                        <h3>Rooms</h3>
                        <div class="value">0</div>
                        <div class="sub-value">Available: <span id="available-rooms">0</span></div>
                    </div>
                    <!-- Add more KPI cards -->
                </div>

                <div class="charts-container">
                    <canvas id="visitsTrend"></canvas>
                    <canvas id="roomsStatus"></canvas>
                </div>
            </div>
        </t>
    </template>
</odoo>