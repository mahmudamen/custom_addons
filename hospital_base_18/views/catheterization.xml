<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="catheterization_classification_form" model="ir.ui.view">
            <field name="name">catheterization_classification_form</field>
            <field name="model">catheterization.classification</field>
            <field name="arch" type="xml">
                <form string="Catheterization Classification">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="service_id" options='{"no_open": True, "no_create": True}'/>
                        </group>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="catheterization_classification_tree" model="ir.ui.view">
            <field name="name">catheterization_classification_tree</field>
            <field name="model">catheterization.classification</field>
            <field name="arch" type="xml">
                <list limit="20">
                    <field name="name"/>
                    <field name="service_id"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>
        <record id="catheterization_classification_action" model="ir.actions.act_window">
            <field name="name">التصنيف</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">catheterization.classification</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="catheterization_classification_menu"
                  name="التصنيف"
                  parent="hospital_base.hospital_catheterization_menu"
                  action="catheterization_classification_action"
                  sequence="11"/>

        <record id="res_catheterization_form" model="ir.ui.view">
            <field name="name">res_catheterization_form</field>
            <field name="model">res.catheterization</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <div class="oe_title">
                            <h4>
                                <field name="name"/>
                            </h4>
                        </div>
                        <group>
                            <group>
                                <field name="classification" options='{"no_open": True, "no_create": True}'/>
                                <field name="service_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="add_exp"/>
                            </group>
                            <group>
                                <field name="clinic_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="amount"/>
                                <field name="is_package"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Medicine" name="medicine_page">
                                <field name="medicine_lines" mode="list">
                                    <list editable="bottom" limit="20">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}' domain="[('detailed_type', '=', 'product')]"/>
                                        <field name="product_type"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                        <field name="unit_cost"/>
                                        <field name="total_cost"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Consumable" name="consumable_page">
                                <field name="consumable_lines" mode="list">
                                    <list editable="bottom" limit="20">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}' domain="[('detailed_type', '=', 'consu')]"/>
                                        <field name="product_type"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                        <field name="unit_cost"/>
                                        <field name="total_cost"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Services" name="service_page">
                                <field name="service_lines" mode="list">
                                    <list editable="bottom" limit="20">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}' domain="[('detailed_type', '=', 'service')]"/>
                                        <field name="product_type"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group string="Cost" class="oe_subtotal_footer">
                            <field name="total_medicine_cost"/>
                            <field name="total_consumable_cost"/>
                            <field name="total_service_cost"/>
                            <field name="total_cost"/>
                        </group>
                        <group string="Amount" class="oe_subtotal_footer">
                            <field name="total_medicine_amount"/>
                            <field name="total_consumable_amount"/>
                            <field name="total_service_amount"/>
                            <field name="total_amount"/>
                        </group>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="res_catheterization_tree" model="ir.ui.view">
            <field name="name">res_catheterization_tree</field>
            <field name="model">res.catheterization</field>
            <field name="arch" type="xml">
                <list limit="20">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="res_catheterization_action" model="ir.actions.act_window">
            <field name="name">عمليات القسطرة</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.catheterization</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="res_catheterization_menu"
                  name="عمليات القسطرة"
                  parent="hospital_base.hospital_catheterization_menu"
                  action="res_catheterization_action"
                  sequence="21"/>

        <record id="catheterization_form" model="ir.ui.view">
            <field name="name">catheterization_form</field>
            <field name="model">catheterization</field>
            <field name="arch" type="xml">
                <form string="Catheterization">
                    <field name="patient_file" invisible="1"/>
                    <header>
                        <button name="action_confirm" string="Confirm" class="oe_highlight"
                                invisible="state != 'waiting'"
                                type="object"/>
                        <button name="button_cancel" string="Cancel" class="oe_highlight"
                                invisible="state != 'waiting'"
                                type="object"/>
                        <button name="button_reset" string="Waiting" class="oe_highlight"
                                invisible="state == 'waiting'"
                                type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="waiting,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h5>
                                <field name="name"/>
                            </h5>
                        </div>
                        <group>
                            <group>
                                <field name="surgery_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="doctor_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="clinic_id" options='{"no_open": True, "no_create": True}'/>
                            </group>
                            <group>
                                <field name="classification"/>
                                <field name="patient_id"/>
                                <field name="date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Medicine" name="medicine_page">
                                <field name="medicine_lines" mode="list">
                                    <list editable="bottom" limit="20">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}'
                                               domain="[('hospital_product_type', '=', 'medicament')]"/>
                                        <field name="product_type" column_invisible="1"/>
                                        <field name="hospital_product_type" column_invisible="1"/>
                                        <field name="available_in" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Consumable" name="consumable_page">
                                <field name="consumable_lines" mode="list">
                                    <list editable="bottom" limit="20">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}'
                                               domain="[('hospital_product_type', '=', 'consumable')]"/>
                                        <field name="product_type" column_invisible="1"/>
                                        <field name="hospital_product_type" column_invisible="1"/>
                                        <field name="available_in" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Services" name="service_page">
                                <field name="device_lines" mode="list">
                                    <list editable="bottom" limit="20">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}'
                                               domain="[('available_in', '=', 'surgeries')]"/>
                                        <field name="product_type" column_invisible="1"/>
                                        <field name="hospital_product_type" column_invisible="1"/>
                                        <field name="available_in" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Surgery Info">
                                <group>
                                    <group>
                                        <field name="anesthesiologist"/>
                                        <field name="nurse_id" widget="many2many_tags" options='{"no_open": True, "no_create": True}'/>
                                    </group>
                                    <group>
                                        <field name="room_id" options='{"no_open": True, "no_create": True}'/>
                                        <field name="worker_id" widget="many2many_tags" options='{"no_open": True, "no_create": True}'/>
                                    </group>
                                </group>
                            </page>
                            <page string="Patient Info">
                                <group>
                                    <group>
                                        <field name="patient_account"/>
                                        <field name="employer"/>
                                        <field name="contract_company"/>
                                        <field name="relative_partner"/>
                                    </group>
                                    <group>
                                        <field name="patient_file" readonly="1"/>
                                        <field name="date_in"/>
                                        <field name="patient_room"/>
                                        <field name="patient_bed"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="catheterization_tree" model="ir.ui.view">
            <field name="name">catheterization_tree</field>
            <field name="model">catheterization</field>
            <field name="arch" type="xml">
                <list limit="20">
                    <field name="name"/>
                    <field name="surgery_id"/>
                    <field name="classification"/>
                    <field name="doctor_id"/>
                    <field name="patient_id"/>
                    <field name="clinic_id"/>
                    <field name="date"/>
                    <field name="state"/>
                    <field name="patient_file" invisible="1"/>
                </list>
            </field>
        </record>
        <record id="catheterization_action" model="ir.actions.act_window">
            <field name="name">القسطرة</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">catheterization</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="catheterization_menu"
                  name="القسطرة"
                  parent="hospital_base.hospital_base_catheterization_menu"
                  action="catheterization_action"
                  sequence="0"/>

    </data>
</odoo>