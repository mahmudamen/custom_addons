<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="clinic_visit_other_form" model="ir.ui.view">
            <field name="name">clinic_visit_other_form</field>
            <field name="model">clinic.visit</field>
            <field name="arch" type="xml">
                <form string="Other Income">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1"/>
                                <field name="notes"/>
                            </group>
                            <group>
                                <field name="product_id" required="1" options="{'no_open': True, 'no_create': True}" domain="[('hospital_product_type', '=', 'os')]"/>
                                <field name="patient_amount"/>
                                <field name="section_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="clinic_visit_other_tree" model="ir.ui.view">
            <field name="name">clinic_visit_other_tree</field>
            <field name="model">clinic.visit</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" readonly="1" force_save="1"/>
                    <field name="product_id" required="1" options="{'no_open': True, 'no_create': True}" domain="[('hospital_product_type', '=', 'os')]"/>
                    <field name="notes"/>
                    <field name="patient_amount" sum="total"/>
                </list>
            </field>
        </record>
        <record id="clinic_visit_other_action" model="ir.actions.act_window">
            <field name="name">أيرادات اخري</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">clinic.visit</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                            (0, 0, {'view_mode': 'list', 'view_id': ref('clinic_visit_other_tree')}),
                            (0, 0, {'view_mode': 'form', 'view_id': ref('clinic_visit_other_form')})]"/>
        </record>

    </data>
</odoo>