<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="sale_order_med" model="ir.ui.view">
            <field name="name">sale_order_med</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="print_receipt_confirm" string="تأكيد وطباعة" invisible="state != 'draft'" type="object" class="btn-primary"/>
                    <button name="print_accounting_receipt" string="طباعة نسخة حسابات" invisible="state == 'draft'" type="object" class="btn-primary"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="doctor"/>
                    <field name="clinic_visit" readonly="1" force_save="1"/>
                    <field name="pharmacy_user" readonly="1" force_save="1"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                    <field name="dosage_id" readonly="1" force_save="1"/>
                    <field name="duration_id" readonly="1" force_save="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>