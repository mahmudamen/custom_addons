<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_partner_patient_form" model="ir.ui.view">
            <field name="name">res_partner_patient_form</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Patient">
                    <header>
                        <field name="patient_code" invisible="1"/>
                        <field name="is_patient" invisible="1"/>
                        <button name="action_generate_patient_code"
                                type="object"
                                string="Generate Patient Code"
                                class="btn-primary"
                                invisible="is_patient ==  False and patient_code !=  False"
                                groups="base.group_user"/>
                    </header>
                    <div class="alert alert-warning oe_edit_only" role="alert" name="warning_tax"
                         invisible="not same_vat_partner_id">
                        A partner with the same
                        <span>
                            <span class="o_vat_label">Tax ID</span>
                        </span>
                        already exists (<field name="same_vat_partner_id"/>), are you sure to create a new one?
                    </div>
                    <div class="alert alert-warning oe_edit_only" role="alert" name="warning_company"
                         invisible="not same_company_registry_partner_id">
                        A partner with the same
                        <span>
                            <span class="o_vat_label">Company Registry</span>
                        </span>
                        already exists (<field name="same_company_registry_partner_id"/>), are you sure to create a new
                        one?
                    </div>
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="avatar_128" invisible="1"/>
                        <field name="image_1920" widget="image" class="oe_avatar"
                               options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                        <div class="oe_title mb24">
                            <field name="is_company" invisible="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="country_code" invisible="1"/>
                            <field name="company_type" invisible="1"/>
                            <field name="is_patient" invisible="1"/>
                            <h1>
                                <field id="individual" options="{'line_breaks': False}" widget="text" class="text-break"
                                       name="name" default_focus="1" placeholder="Patient Name"
                                       required="True"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <span class="o_form_label o_td_label" name="address_name">
                                    <field name="type" invisible="is_company" readonly="user_ids"
                                           required="not is_company"
                                           class="fw-bold"/>
                                    <b invisible="not is_company">Address</b>
                                </span>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State"
                                           options="{'no_open': True, 'no_quick_create': True}"
                                           context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <div name="partner_address_country" class="d-flex justify-content-between">
                                        <field name="country_id" placeholder="Country" class="o_address_country"
                                               options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                    </div>
                                </div>
                                <field name="patient_code" readonly="1"/>
                            </group>
                            <group>
                                <field name="phone" widget="phone"/>
                                <field name="mobile" widget="phone"/>
                                <field name="nat_id" placeholder="10203040506070"/>
                                <field name="vat" placeholder="e.g. BE0477472701"/>
                                <field name="user_ids" invisible="1"/>
                                <field name="active_lang_count" invisible="1"/>
                                <field name="lang" invisible="active_lang_count &lt;= 1"/>
                                <field name="category_id" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': True}"
                                       placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ..."/>
                            </group>
                        </group>

                        <notebook colspan="4">
                            <page string="بيانات المريض" name="patient_data" autofocus="autofocus"
                                  invisible="is_patient == False">
                                <group>
                                    <group>
                                        <field name="patient_account" required="is_patient == True"/>
                                    </group>

                                </group>
                                <group>
                                    <group>
                                        <field name="employer" required="patient_account == 'contract'"/>
                                    </group>
                                    <group>
                                        <field name="contract_company" required="patient_account == 'contract'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="res_partner_patient_tree" model="ir.ui.view">
            <field name="name">res.partner.patient.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list>
                    <field name="patient_code"/>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="nat_id"/>
                    <field name="patient_account"/>
                    <field name="employer"/>
                    <field name="contract_company"/>
                    <field name="company_type" column_invisible="True"/>
                    <field name="is_patient" column_invisible="True"/>
                </list>
            </field>
        </record>
        <record id="res_partner_patient_action" model="ir.actions.act_window">
            <field name="name">المرضي</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_patient', '=', True), ('company_type', '=', 'patient')]</field>
            <field name="context">{'default_company_type': 'patient', 'default_is_patient': True}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('res_partner_patient_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('res_partner_patient_form')}),
            ]"/>
        </record>

        <menuitem id="res_partner_patient_menu"
                  name="المرضي"
                  parent="hospital_base.hospital_patient_menu"
                  action="res_partner_patient_action"
                  sequence="100"/>

    </data>
</odoo>