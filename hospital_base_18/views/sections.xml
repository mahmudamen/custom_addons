<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sections_form" model="ir.ui.view">
            <field name="name">sections_form</field>
            <field name="model">res.sections</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <div class="oe_title">
                            <h5>
                                <field name="name" placeholder="Draft"/>
                                <field name="sequence" invisible="1"/>
                            </h5>
                        </div>
                        <group>
                            <group>
                                <field name="type" widget="radio"/>
                            </group>
                            <group>
                                <field name="location_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="analytic_account_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="journal_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="income_account_id" options='{"no_open": True, "no_create": True}'/>
                            </group>
                        </group>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="sections_tree" model="ir.ui.view">
            <field name="name">sections_tree</field>
            <field name="model">res.sections</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="income_account_id"/>
                    <field name="location_id"/>
                    <field name="analytic_account_id"/>
                    <field name="type"/>
                </list>
            </field>
        </record>
        <record id="sections_action" model="ir.actions.act_window">
            <field name="name">اﻷقسام</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.sections</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="sections_menu"
                  name="اﻷقسام"
                  parent="hospital_base.hospital_base_menu"
                  action="sections_action"
                  sequence="100"/>

    </data>
</odoo>