<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="clinic_view_form" model="ir.ui.view">
            <field name="name">clinic_view_form</field>
            <field name="model">res.clinics</field>
            <field name="arch" type="xml">
                <form string="Clinics">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="clinic_view_tree" model="ir.ui.view">
            <field name="name">clinic_view_tree</field>
            <field name="model">res.clinics</field>
            <field name="arch" type="xml">
                <list limit="20">
                    <field name="name"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>
        <record id="clinic_view_action" model="ir.actions.act_window">
            <field name="name">العيادات</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.clinics</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="clinic_view_menu"
                  name="العيادات"
                  parent="hospital_base.hospital_clinic_menu"
                  action="clinic_view_action"
                  sequence="10"/>

    </data>
</odoo>