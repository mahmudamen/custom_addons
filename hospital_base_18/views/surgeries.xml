<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="surgeries_classification_form" model="ir.ui.view">
            <field name="name">surgeries_classification_form</field>
            <field name="model">surgeries.classification</field>
            <field name="arch" type="xml">
                <form string="Surgeries Classification">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="service_id" options='{"no_open": True, "no_create": True}'/>
                        </group>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="surgeries_classification_tree" model="ir.ui.view">
            <field name="name">surgeries_classification_tree</field>
            <field name="model">surgeries.classification</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="service_id"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>
        <record id="surgeries_classification_action" model="ir.actions.act_window">
            <field name="name">تصنيف العمليات</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">surgeries.classification</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="surgeries_classification_menu"
                  name="تصنيف العمليات"
                  parent="hospital_base.hospital_surgeries_menu"
                  action="surgeries_classification_action"
                  sequence="10"/>

        <record id="res_surgeries_form" model="ir.ui.view">
            <field name="name">res_surgeries_form</field>
            <field name="model">res.surgeries</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <div class="oe_title">
                            <h4>
                                <field name="name"/>
                            </h4>
                        </div>
                        <group>
                            <group>
                                <field name="classification" options='{"no_open": True, "no_create": True}'/>
                                <field name="service_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="add_exp"/>
                            </group>
                            <group>
                                <field name="clinic_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="amount"/>
                                <field name="is_package"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="أدوية" name="medicine_page">
                                <field name="medicine_lines" mode="list">
                                    <list editable="bottom">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}' domain="[('detailed_type', '=', 'product')]"/>
                                        <field name="product_type"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                        <field name="unit_cost"/>
                                        <field name="total_cost"/>
                                    </list>
                                </field>
                            </page>
                            <page string="مستهلكات" name="consumable_page">
                                <field name="consumable_lines" mode="list">
                                    <list editable="bottom">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}' domain="[('detailed_type', '=', 'consu')]"/>
                                        <field name="product_type"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                        <field name="unit_cost"/>
                                        <field name="total_cost"/>
                                    </list>
                                </field>
                            </page>
                            <page string="الخدمات" name="service_page">
                                <field name="service_lines" mode="list">
                                    <list editable="bottom">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}' domain="[('detailed_type', '=', 'service')]"/>
                                        <field name="product_type"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group string="التكلفة" class="oe_subtotal_footer">
                            <field name="total_medicine_cost"/>
                            <field name="total_consumable_cost"/>
                            <field name="total_service_cost"/>
                            <field name="total_cost"/>
                        </group>
                        <group string="القيمة" class="oe_subtotal_footer">
                            <field name="total_medicine_amount"/>
                            <field name="total_consumable_amount"/>
                            <field name="total_service_amount"/>
                            <field name="total_amount"/>
                        </group>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="res_surgeries_tree" model="ir.ui.view">
            <field name="name">res_surgeries_tree</field>
            <field name="model">res.surgeries</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="res_surgeries_action" model="ir.actions.act_window">
            <field name="name">العمليات</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.surgeries</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="res_surgeries_menu"
                  name="العمليات"
                  parent="hospital_base.hospital_surgeries_menu"
                  action="res_surgeries_action"
                  sequence="20"/>

        <record id="surgeries_form" model="ir.ui.view">
            <field name="name">surgeries_form</field>
            <field name="model">surgeries</field>
            <field name="arch" type="xml">
                <form string="Surgeries">
                    <field name="patient_file" invisible="1"/>
                    <header>
                        <button name="action_confirm" string="تاكيد" class="oe_highlight"
                                invisible="state != 'waiting'"
                                type="object"/>
                        <button name="button_cancel" string="الغاء" class="oe_highlight"
                                invisible="state != 'waiting'"
                                type="object"/>
                        <button name="button_reset" string="انتظار" class="oe_highlight"
                                invisible="state == 'waiting'"
                                type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="waiting,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h5>
                                <field name="name"/>
                            </h5>
                        </div>
                        <group>
                            <group>
                                <field name="surgery_id"  options='{"no_open": True, "no_create": True}'/>
                                <field name="doctor_id" domain="[('is_doctor', '=', True)]" options='{"no_open": True, "no_create": True}'/>
                                <field name="clinic_id" options='{"no_open": True, "no_create": True}'/>
                            </group>
                            <group>
                                <field name="classification"/>
                                <field name="patient_id" domain="[('is_patient', '=', True)]"/>
                                <field name="date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="بيانات العملية">
                                <group>
                                    <group>
                                        <field name="anesthesiologist" domain="[('is_doctor', '=', True)]"/>
                                        <field name="nurse_id"  widget="many2many_tags" options='{"no_open": True, "no_create": True}'/>
                                    </group>
                                    <group>
                                        <field name="room_id" options='{"no_open": True, "no_create": True}'/>
                                        <field name="worker_id"  widget="many2many_tags" options='{"no_open": True, "no_create": True}'/>
                                    </group>
                                </group>
                            </page>
                            <page string="ادوية" name="medicine_page">
                                <field name="medicine_lines" mode="list">
                                    <list editable="bottom">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}'
                                               domain="[('hospital_product_type', '=', 'medicament')]"/>
                                        <field name="product_type" column_invisible="1"/>
                                        <field name="hospital_product_type" column_invisible="1"/>
                                        <field name="available_in" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                            <page string="مستهلكات" name="consumable_page">
                                <field name="consumable_lines" mode="list">
                                    <list editable="bottom">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}'
                                               domain="[('hospital_product_type', '=', 'consumable')]"/>
                                        <field name="product_type" column_invisible="1"/>
                                        <field name="hospital_product_type" column_invisible="1"/>
                                        <field name="available_in" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                            <page string="خدمات" name="service_page">
                                <field name="device_lines" mode="list">
                                    <list editable="bottom">
                                        <field name="product_id" options='{"no_open": True, "no_create": True}'
                                               domain="[('available_in', '=', 'surgeries')]"/>
                                        <field name="product_type" column_invisible="1"/>
                                        <field name="hospital_product_type" column_invisible="1"/>
                                        <field name="available_in" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>

                            <page string="بيانات المريض">
                                <group>
                                    <group>
                                        <field name="patient_account"/>
                                        <field name="employer"/>
                                        <field name="contract_company"/>
                                        <field name="relative_partner"/>
                                    </group>
                                    <group>
                                        <field name="patient_file" readonly="1"/>
                                        <field name="date_in"/>
                                        <field name="patient_room"/>
                                        <field name="patient_bed"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="surgeries_tree" model="ir.ui.view">
            <field name="name">surgeries_tree</field>
            <field name="model">surgeries</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="surgery_id"/>
                    <field name="classification"/>
                    <field name="doctor_id"/>
                    <field name="patient_id"/>
                    <field name="clinic_id"/>
                    <field name="date"/>
                    <field name="state"/>
                    <field name="patient_file" invisible="1"/>
                </list>
            </field>
        </record>
        <record id="surgeries_action" model="ir.actions.act_window">
            <field name="name">العمليات</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">surgeries</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="surgeries_menu"
                  name="العمليات"
                  parent="hospital_base.hospital_base_surgeries_menu"
                  action="surgeries_action"
                  sequence="0"/>

    </data>
</odoo>