<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Exit Report Template -->
    <template id="report_patient_exit_print">
        <style>
            /* Universal font family for Arabic and Latin text */
            * {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Tahoma', 'Arial', 'Helvetica Neue', sans-serif;
            }

            .page {
                page-break-after: always;
                page-break-inside: avoid;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Tahoma', 'Arial', 'Helvetica Neue', sans-serif;
            }
            .page:last-child {
                page-break-after: auto;
            }
        </style>
        <div class="arabic-report-container" dir="rtl" lang="ar">
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.html_container">
                <t t-call="hospital_base.clinic_internal_layout">
                    <div class="page arabic-report" dir="rtl">
                        <t t-foreach="docs" t-as="doc">
                            <!-- Header Section -->
                            <div class="header-section" style="
                                border-bottom: 3px solid #FF8C00;
                                padding-bottom: 5px;
                                margin-bottom: 5px;
                                text-align: center;">
                                <h1 style="
                                    font-size: 24px;
                                    font-weight: bold;
                                    color: #1f4e79;
                                    margin: 0;
                                ">تقرير خروج المريض</h1>
                            </div>
                            <!-- Patient Basic Information -->
                            <div class="row" style="margin: 10px 10px;">
                                <div class="col-12">
                                    <div class="info-row">
                                        <strong style="font-size: 20px; color: #666;">رقم الملف:</strong>
                                        <span t-esc="doc.name" style="color: #333; font-size: 20px; font-weight: bold;"/>
                                    </div>
                                    <div class="info-row">
                                        <strong style="font-size: 20px; color: #666;">اسم المريض:</strong>
                                        <span t-esc="doc.patient_id.name" style="font-size: 20px; color: #333; font-weight: bold;"/>
                                    </div>
                                    <div class="info-row">
                                        <strong style="font-size: 20px; color: #666;">تاريخ الدخول:</strong>
                                        <span t-esc="doc.date_in" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}" style="font-size: 20px; color: #333;"/>
                                    </div>
                                    <div class="info-row">
                                        <strong style="font-size: 20px; color: #666;">تاريخ الخروج:</strong>
                                        <span t-esc="doc.date_out" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}" style="font-size: 20px; color: #333; font-weight: bold;"/>
                                    </div>
                                </div>
                            </div>
                            <!-- Medical Team Information -->
                            <div class="row" style="margin: 0 10px;">
                                <div class="col-12">
                                    <div class="info-row">
                                        <strong style="font-size: 20px; color: #666;">الطبيب :</strong>
                                        <span t-esc="doc.doctor_id.name or '-------'" style="font-size: 20px; color: #333; font-weight: bold;"/>
                                    </div>
                                </div>
                            </div>
                            <!-- Medical Information -->
                            <div style="margin: 0 10px;">
                                <div class="info-row">
                                    <strong style="font-size: 20px; color: #666;">التشخيص عند الدخول:</strong>
                                        <span t-esc="doc.diagnosis or '---------------'" style="font-size: 20px; color: #333;"/>
                                </div>
                                <div class="info-row">
                                    <strong style="font-size: 20px; color: #666;">العملية:</strong>
                                        <span t-esc="doc.note or '-------------------------'" style="font-size: 20px; color: #333;"/>
                                </div>
                                <t t-if="doc.discharge_summary">
                                        <strong style="font-size: 20px; color: #666;">التوصيات الطبية:</strong>
                                            <span t-esc="doc.discharge_summary" style="font-size: 20px; color: #333;"/>
                                </t>
                                <div class="info-row" style="margin-top: 15px;">
                                    <strong style="font-size: 20px; color: #666;">حالة المريض عند الخروج:</strong>
                                    <span style="color: #333; font-weight: bold; margin-right: 10px; font-size: 20px;">
                                        <t t-if="doc.discharge_condition == 'improved'">تحسن</t>
                                        <t t-elif="doc.discharge_condition == 'cured'">شفي</t>
                                        <t t-elif="doc.discharge_condition == 'stable'">مستقر</t>
                                        <t t-elif="doc.discharge_condition == 'transferred'">محول</t>
                                        <t t-elif="doc.discharge_condition == 'deceased'">متوفي</t>
                                        <t t-elif="doc.discharge_condition == 'against_advice'">خروج ضد المشورة الطبية</t>
                                        <t t-else="">لم يتم تحديد الحالة</t>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <strong style="font-size: 20px; color: #666;">ملاحظات:</strong>
                                        <span t-esc="doc.remark or '------------------'" style="font-size: 20px; color: #333;"/>
                                </div>
                            </div>
                            <!-- Footer -->
                            <div style="
                                margin-top: 100px;
                                padding-top: 100px;
                                border-top: 5px solid #4472c4;
                                text-align: center;
                            ">
                                <div style="font-size: 12px; color: #666;">
                                    <span>تاريخ الطباعة: </span>
                                    <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </template>

    <!-- Report Action -->
    <record id="action_report_patient_exit" model="ir.actions.report">
        <field name="name">تقرير خروج المريض</field>
        <field name="model">patient.file</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_base.report_patient_exit_print</field>
        <field name="report_file">hospital_base.report_patient_exit_print</field>
        <field name="print_report_name">'تقرير خروج - ' + (object.name or '')</field>
        <field name="binding_model_id" ref="model_patient_file"/>
        <field name="binding_type">report</field>
    </record>
</odoo>